{
  "description": "在后台按可配置轮次维护 Codex 话题标题，并低频归档连续 7 天无新对话的话题。",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/scripts/oil_codex_title_trigger.py\" hook",
            "async": true,
            "timeout": 500,
            "commandWindows": "py -3 -X utf8 \"${PLUGIN_ROOT}/scripts/oil_codex_title_trigger.py\" hook"
          }
        ]
      }
    ]
  }
}
